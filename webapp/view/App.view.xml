<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="com.acme.portal.framework.controller.App">
  <Page showHeader="false" enableScrolling="false">
    <VBox fitContainer="true">
      <Toolbar class="portalHeader">
        <core:Icon src="sap-icon://business-objects-experience" class="portalBrandIcon"/>
        <VBox class="portalBrand"><Title text="Enterprise Portal" level="H2"/><Text text="UI5 MDI Reference Portal"/></VBox>
        <ToolbarSpacer/><Button text="홈" icon="sap-icon://home" type="Transparent" press=".onPortalHome"/>
        <VBox class="headerSelectorGroup"><Text text="데모 사용자 역할" class="headerHint" tooltip="선택한 역할에 따라 메뉴와 실행 가능한 앱이 변경됩니다."/><Select width="12.5rem" selectedKey="{portal>/currentRole}" change=".onRoleChange" tooltip="역할 기반 메뉴·권한 시연"><items><core:Item key="PORTAL_USER" text="포털 사용자 · PORTAL_USER"/><core:Item key="FI_USER" text="재무 담당자 · FI_USER"/><core:Item key="HR_USER" text="인사 담당자 · HR_USER"/><core:Item key="APPROVER" text="승인 담당자 · APPROVER"/><core:Item key="PORTAL_ADMIN" text="포털 관리자 · PORTAL_ADMIN"/></items></Select></VBox>
        <VBox class="headerSelectorGroup"><Text text="MDI Workspace 방식" class="headerHint" tooltip="오른쪽 Workspace의 탭 컨테이너 구현 방식을 변경합니다."/><Select width="14rem" selectedKey="{portal>/workspaceAdapter}" change=".onWorkspaceAdapterChange" tooltip="MDI Workspace 실행 방식"><items><core:Item key="UI5_TAB" text="기본: UI5 통합 탭"/><core:Item key="IFRAME" text="Non-SAP: iframe 전용 탭"/><core:Item key="CUSTOM" text="확장: 고객사 Custom MDI"/></items></Select></VBox>
        <Button text="관리자 설정" icon="sap-icon://settings" visible="{= ${portal>/currentRole} === 'PORTAL_ADMIN' }" press=".onOpenAdmin"/><Avatar initials="JD" displaySize="XS" tooltip="Jane Doe"/>
      </Toolbar>
      <HBox fitContainer="true" class="portalBody">
        <VBox width="20rem" class="sideNav">
          <Title text="Navigation" level="H4" class="navigationTitle"/><SearchField width="100%" placeholder="메뉴 검색" liveChange=".onSearch"/>
          <SegmentedButton width="100%" selectedKey="{portal>/currentCollection}" selectionChange=".onNavSelect"><items><SegmentedButtonItem key="menu" text="메뉴" icon="sap-icon://menu2"/><SegmentedButtonItem key="favorites" text="즐겨찾기" icon="sap-icon://favorite"/><SegmentedButtonItem key="recent" text="최근" icon="sap-icon://history"/></items></SegmentedButton>
          <Tree id="menuTree" visible="{= ${portal>/currentCollection} === 'menu' }" items="{path: 'portal>/menuTree', parameters: {arrayNames: ['children']}}" mode="None" itemPress=".onMenuPress"><items><CustomTreeItem type="{= ${portal>applicationId} ? 'Active' : 'Inactive' }"><HBox width="100%" justifyContent="SpaceBetween" alignItems="Center"><HBox alignItems="Center"><core:Icon src="{portal>icon}" class="menuItemIcon"/><VBox><Title text="{portal>title}" level="H5"/><Text text="{portal>description}" visible="{= !!${portal>applicationId} }"/></VBox></HBox><Button icon="{= ${portal>favorite} ? 'sap-icon://favorite' : 'sap-icon://unfavorite' }" type="Transparent" tooltip="즐겨찾기" visible="{= !!${portal>applicationId} }" press=".onToggleFavorite"/></HBox></CustomTreeItem></items></Tree>
          <List id="menuList" visible="{= ${portal>/currentCollection} !== 'menu' }" items="{portal>/visibleMenus}" mode="None" itemPress=".onMenuPress"><items><CustomListItem type="Active"><HBox width="100%" justifyContent="SpaceBetween" alignItems="Center"><HBox alignItems="Center"><core:Icon src="{portal>icon}" class="menuItemIcon"/><VBox><Title text="{portal>title}" level="H5"/><Text text="{portal>description}"/></VBox></HBox><Button icon="{= ${portal>favorite} ? 'sap-icon://favorite' : 'sap-icon://unfavorite' }" type="Transparent" tooltip="즐겨찾기" press=".onToggleFavorite"/></HBox></CustomListItem></items></List>
        </VBox>
        <VBox fitContainer="true" class="workspace">
          <Toolbar class="workspaceHeader"><VBox><Title text="Workspace"/><Text text="업무 애플리케이션을 하나의 Portal에서 실행합니다."/></VBox><ToolbarSpacer/><ObjectStatus text="현재 MDI: {portal>/workspaceAdapterInfo/label}" icon="sap-icon://process" state="Information" class="workspaceAdapterStatus"/><Button text="활동 로그" icon="sap-icon://activity-items" type="Transparent" press=".onOpenActivityLog"/><Button text="현재 앱에 메시지 보내기" icon="sap-icon://discussion-2" type="Transparent" visible="{= ${portal>/openedApplications}.length > 0 }" press=".onSendTestMessage"/><Button text="현재 탭 닫기" icon="sap-icon://decline" type="Transparent" visible="{= ${portal>/openedApplications}.length > 0 }" press=".onCloseActive"/><Button text="전체 닫기" icon="sap-icon://decline" type="Transparent" visible="{= ${portal>/openedApplications}.length > 1 }" press=".onCloseAll"/></Toolbar>
          <HBox class="workspaceAdapterPanel" alignItems="Center" justifyContent="SpaceBetween"><HBox alignItems="Center"><core:Icon src="sap-icon://process" size="1.45rem"/><VBox><Title text="{portal>/workspaceAdapterInfo/label}" level="H4"/><Text text="{portal>/workspaceAdapterInfo/description}"/><Text text="{portal>/workspaceAdapterInfo/supportedApplications}" class="workspaceAdapterSupport"/></VBox></HBox><ObjectStatus text="{portal>/workspaceAdapterInfo/visualCue}" state="Information"/></HBox>
          <MessageStrip text="{portal>/lastMessage}" type="Information" showIcon="true" visible="{= !!${portal>/lastMessage} }"/>
          <VBox visible="{= !${portal>/adminOpen} &amp;&amp; ${portal>/openedApplications}.length === 0 }" class="workspaceWelcome" alignItems="Center" justifyContent="Center"><core:Icon src="sap-icon://home-share" size="3rem"/><Title text="업무를 시작하세요" level="H2"/><Text text="좌측 메뉴에서 애플리케이션을 선택하면 이 Workspace에서 실행됩니다." textAlign="Center"/><HBox class="workspaceCapabilities"><ObjectStatus text="역할 기반 메뉴" icon="sap-icon://employee" state="Information"/><ObjectStatus text="SAP · Non-SAP 통합" icon="sap-icon://connected" state="Information"/><ObjectStatus text="교체 가능한 MDI Adapter" icon="sap-icon://process" state="Information"/></HBox></VBox>
          <VBox id="workspaceContent" visible="{= !${portal>/adminOpen} &amp;&amp; ${portal>/openedApplications}.length > 0 }" fitContainer="true" class="workspaceContent"/>
          <VBox visible="{= !${portal>/adminOpen} &amp;&amp; ${portal>/openedApplications}.length === 0 }" class="workspaceDashboard">
            <HBox justifyContent="SpaceBetween" alignItems="Center" class="dashboardHeading"><VBox><Title text="Portal Dashboard" level="H2"/><Text text="Portal 시작 화면입니다. 자주 쓰는 업무를 바로 실행하고 최근 작업을 이어가세요."/></VBox><ObjectStatus text="통합 상태 정상" icon="sap-icon://sys-enter-2" state="Success"/></HBox>
            <HBox class="dashboardColumns" justifyContent="SpaceBetween" alignItems="Start"><VBox width="64%" class="dashboardCard"><Title text="빠른 실행" level="H3"/><Text text="권한이 있는 업무를 Workspace에서 바로 실행합니다."/><FlexBox wrap="Wrap" items="{portal>/dashboardQuickLaunch}" class="quickTileArea"><items><GenericTile header="{portal>title}" subheader="{portal>description}" press=".onDashboardOpen" class="quickTile"><tileContent><TileContent><content><NewsContent contentText="Workspace에서 실행" subheader="{portal>applicationId}"/></content></TileContent></tileContent></GenericTile></items></FlexBox><Text visible="{= ${portal>/dashboardQuickLaunch}.length === 0 }" text="현재 역할에 실행 가능한 업무가 없습니다." class="dashboardEmpty"/></VBox><VBox width="33%" class="dashboardCard"><Title text="최근 실행" level="H3"/><Text text="개인별 최근 업무 이력입니다."/><List items="{portal>/dashboardRecent}" mode="None" itemPress=".onDashboardOpen"><items><StandardListItem title="{portal>title}" description="{portal>description}" icon="{portal>icon}" type="Active"/></items></List><Text visible="{= ${portal>/dashboardRecent}.length === 0 }" text="아직 실행한 업무가 없습니다." class="dashboardEmpty"/></VBox></HBox>
            <HBox class="dashboardColumns dashboardBottom" justifyContent="SpaceBetween" alignItems="Start"><VBox width="64%" class="dashboardCard"><Title text="공지사항" level="H3"/><List mode="None"><StandardListItem title="Enterprise Portal Framework PoC 시연 환경" description="SAP 및 Non-SAP 애플리케이션을 하나의 Workspace에서 통합 실행합니다." icon="sap-icon://announcement"/><StandardListItem title="Workspace Adapter 확장 가능" description="고객별 MDI·탭 컨테이너는 Portal Core 수정 없이 Adapter로 연계합니다." icon="sap-icon://process"/></List></VBox><VBox width="33%" class="dashboardCard"><Title text="Portal 상태" level="H3"/><ObjectStatus text="역할 기반 메뉴 필터링 활성" icon="sap-icon://employee" state="Success"/><ObjectStatus text="SAP · Non-SAP 실행 모델 준비" icon="sap-icon://connected" state="Information"/><ObjectStatus text="메시지 Envelope 연계 가능" icon="sap-icon://discussion-2" state="Information"/></VBox></HBox>
            <HBox class="dashboardColumns dashboardBottom" justifyContent="SpaceBetween" alignItems="Start"><VBox width="64%" class="dashboardCard"><Title text="애플리케이션 실행 카탈로그" level="H3"/><Text text="현재 역할로 실행 가능한 SAP·Non-SAP 애플리케이션입니다. 항목을 선택하면 즉시 실행됩니다."/><List items="{portal>/applicationCatalog}" mode="None" itemPress=".onCatalogOpen"><items><StandardListItem title="{portal>title}" description="{= ${portal>applicationType} + ' · ' + ${portal>navigationMode} }" info="실행" infoState="Information" icon="{portal>icon}" type="Active"/></items></List></VBox><VBox width="33%" class="dashboardCard"><Title text="Workspace Adapter" level="H3"/><ObjectStatus text="{portal>/workspaceAdapterInfo/label}" icon="sap-icon://process" state="Information"/><Text text="{portal>/workspaceAdapterInfo/description}" class="adapterDescription"/><Text text="상단 선택기로 Adapter를 변경한 뒤 같은 카탈로그 항목을 실행해 비교할 수 있습니다." class="adapterHint"/></VBox></HBox>
          </VBox>
          <ScrollContainer visible="{portal>/adminOpen}" height="100%" vertical="true" horizontal="true" class="adminScroll"><VBox id="adminPanel" class="adminPanel">
            <Toolbar class="adminHeader"><VBox><Title text="Portal 관리자 설정"/><Text text="메뉴, 실행 애플리케이션 및 권한을 관리합니다."/></VBox><ToolbarSpacer/><Button text="저장" icon="sap-icon://save" type="Emphasized" press=".onSaveAdmin"/><Button text="닫기" press=".onCloseAdmin"/></Toolbar>
            <IconTabBar expandable="false"><items>
              <IconTabFilter text="메뉴" icon="sap-icon://menu2"><HBox class="adminEditor" fitContainer="true">
                <VBox width="18rem" class="adminMaster"><Toolbar><Title text="메뉴"/><ToolbarSpacer/><Button icon="sap-icon://add" tooltip="메뉴 추가" press=".onAddMenu"/></Toolbar><List id="adminMenuList" items="{admin>/menus}" mode="SingleSelectMaster" selectionChange=".onAdminMenuSelect"><items><StandardListItem title="{admin>title}" description="{admin>id}" icon="{admin>icon}"/></items></List></VBox>
                <VBox class="adminDetail" fitContainer="true"><Title text="메뉴 상세" level="H3"/><Text text="선택한 메뉴의 실행 대상과 권한을 설정합니다."/><HBox class="formRow"><VBox><Label text="메뉴 ID"/><Input value="{admin>/selectedMenu/id}"/></VBox><VBox><Label text="메뉴명"/><Input value="{admin>/selectedMenu/title}"/></VBox><VBox><Label text="표시 순서"/><Input value="{admin>/selectedMenu/order}" type="Number"/></VBox></HBox><HBox class="formRow"><VBox><Label text="상위 업무 그룹"/><Input value="{admin>/selectedMenu/parentId}" placeholder="예: finance, hr"/></VBox><VBox><Label text="실행 애플리케이션"/><Select selectedKey="{admin>/selectedMenu/applicationId}" items="{admin>/applications}"><items><core:Item key="{admin>id}" text="{admin>title}"/></items></Select></VBox><VBox><Label text="역할"/><Input value="{admin>/selectedMenu/rolesText}" placeholder="PORTAL_USER, FI_USER"/></VBox></HBox><HBox class="formRow"><VBox><Label text="설명"/><Input value="{admin>/selectedMenu/description}"/></VBox><VBox><Label text="아이콘"/><Input value="{admin>/selectedMenu/icon}"/></VBox><VBox><Label text="활성화"/><Switch state="{admin>/selectedMenu/active}"/></VBox></HBox><Toolbar><ToolbarSpacer/><Button text="선택 메뉴 삭제" icon="sap-icon://delete" type="Negative" press=".onDeleteSelectedMenu"/></Toolbar></VBox>
              </HBox></IconTabFilter>
              <IconTabFilter text="애플리케이션" icon="sap-icon://application"><HBox class="adminEditor" fitContainer="true">
                <VBox width="18rem" class="adminMaster"><Toolbar><Title text="애플리케이션"/><ToolbarSpacer/><Button icon="sap-icon://add" tooltip="애플리케이션 추가" press=".onAddApplication"/></Toolbar><List id="adminApplicationList" items="{admin>/applications}" mode="SingleSelectMaster" selectionChange=".onAdminApplicationSelect"><items><StandardListItem title="{admin>title}" description="{admin>applicationType}" icon="{admin>icon}"/></items></List></VBox>
                <VBox class="adminDetail" fitContainer="true"><Title text="애플리케이션 상세" level="H3"/><Text text="실행 방식과 대상 URL 또는 UI5 Component를 설정합니다."/><HBox class="formRow"><VBox><Label text="애플리케이션 ID"/><Input value="{admin>/selectedApplication/id}"/></VBox><VBox><Label text="제목"/><Input value="{admin>/selectedApplication/title}"/></VBox><VBox><Label text="실행 유형"/><Select selectedKey="{admin>/selectedApplication/applicationType}"><items><core:Item key="UI5_COMPONENT" text="UI5_COMPONENT"/><core:Item key="IFRAME" text="IFRAME"/><core:Item key="EXTERNAL_WINDOW" text="EXTERNAL_WINDOW"/><core:Item key="CUSTOM_HANDLER" text="CUSTOM_HANDLER"/></items></Select></VBox></HBox><HBox class="formRow"><VBox><Label text="실행 대상"/><Input value="{admin>/selectedApplication/target}" placeholder="URL 또는 Component namespace"/></VBox><VBox><Label text="Navigation Mode"/><Select selectedKey="{admin>/selectedApplication/navigationMode}"><items><core:Item key="TAB" text="TAB"/><core:Item key="NEW_WINDOW" text="NEW_WINDOW"/></items></Select></VBox><VBox><Label text="역할"/><Input value="{admin>/selectedApplication/rolesText}" placeholder="PORTAL_USER, FI_USER"/></VBox></HBox><HBox class="formRow"><VBox><Label text="설명"/><Input value="{admin>/selectedApplication/description}"/></VBox><VBox><Label text="아이콘"/><Input value="{admin>/selectedApplication/icon}"/></VBox><VBox><Label text="활성화"/><Switch state="{admin>/selectedApplication/active}"/></VBox></HBox><Toolbar><ToolbarSpacer/><Button text="선택 애플리케이션 삭제" icon="sap-icon://delete" type="Negative" press=".onDeleteSelectedApplication"/></Toolbar></VBox>
              </HBox></IconTabFilter>
            </items></IconTabBar>
          </VBox></ScrollContainer>
        </VBox>
      </HBox>
    </VBox>
  </Page>
</mvc:View>
