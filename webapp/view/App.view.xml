<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="com.acme.portal.framework.controller.App">
  <Page showHeader="false" enableScrolling="false">
    <VBox fitContainer="true">
      <Toolbar class="portalHeader">
        <core:Icon src="sap-icon://business-objects-experience" class="portalBrandIcon"/>
        <VBox class="portalBrand"><Title text="Enterprise Portal" level="H2"/><Text text="UI5 MDI Reference Portal"/></VBox>
        <ToolbarSpacer/><Button icon="sap-icon://home" type="Transparent" tooltip="홈" width="2.5rem" class="headerHomeButton" press=".onPortalHome"/>
        <VBox class="headerSelectorGroup"><Text text="데모 사용자 역할" class="headerHint" tooltip="선택한 역할에 따라 메뉴와 실행 가능한 앱이 변경됩니다."/><Select width="12.5rem" selectedKey="{portal>/currentRole}" change=".onRoleChange" tooltip="역할 기반 메뉴·권한 시연"><items><core:Item key="PORTAL_USER" text="포털 사용자 · PORTAL_USER"/><core:Item key="FI_USER" text="재무 담당자 · FI_USER"/><core:Item key="HR_USER" text="인사 담당자 · HR_USER"/><core:Item key="APPROVER" text="승인 담당자 · APPROVER"/><core:Item key="PORTAL_ADMIN" text="포털 관리자 · PORTAL_ADMIN"/></items></Select></VBox>
        <VBox class="headerSelectorGroup"><Text text="MDI Workspace 방식" class="headerHint" tooltip="오른쪽 Workspace의 탭 컨테이너 구현 방식을 변경합니다."/><Select width="14rem" selectedKey="{portal>/workspaceAdapter}" change=".onWorkspaceAdapterChange" tooltip="MDI Workspace 실행 방식"><items><core:Item key="UI5_TAB" text="기본: UI5 통합 탭"/><core:Item key="IFRAME" text="Non-SAP: iframe 전용 탭"/><core:Item key="CUSTOM" text="확장: 고객사 Custom MDI"/></items></Select></VBox>
        <Button text="관리자 설정" icon="sap-icon://settings" visible="{= ${portal>/currentRole} === 'PORTAL_ADMIN' }" press=".onOpenAdmin"/><Avatar initials="임" displaySize="XS" tooltip="임우상"/>
      </Toolbar>
      <HBox fitContainer="true" class="portalBody">
        <VBox width="18.5rem" class="sideNav">
          <HBox alignItems="Center" class="sideNavHeading">
            <HBox alignItems="Center" justifyContent="Center" class="sideNavHeadingIcon"><core:Icon src="sap-icon://grid"/></HBox>
            <VBox class="sideNavHeadingText"><Text text="MY WORKSPACE" class="sideNavEyebrow"/><Title text="업무 내비게이션" level="H3"/></VBox>
            <ObjectStatus text="{= ${portal>/navigationApplicationCount} + '개' }" state="Information" class="sideNavCount"/>
          </HBox>
          <SearchField width="100%" placeholder="업무 메뉴 검색" liveChange=".onSearch" class="sideNavSearch"/>
          <SegmentedButton width="100%" selectedKey="{portal>/currentCollection}" selectionChange=".onNavSelect" class="sideNavCollections"><items><SegmentedButtonItem key="menu" text="전체" icon="sap-icon://menu2"/><SegmentedButtonItem key="favorites" text="즐겨찾기" icon="sap-icon://favorite"/><SegmentedButtonItem key="recent" text="최근" icon="sap-icon://history"/></items></SegmentedButton>
          <VBox fitContainer="true" class="sideNavContent">
            <Tree id="menuTree" visible="{= ${portal>/currentCollection} === 'menu' }" items="{path: 'portal>/menuTree', parameters: {arrayNames: ['children']}}" mode="None" itemPress=".onMenuPress" class="portalMenuTree"><items><CustomTreeItem type="{= ${portal>applicationId} ? 'Active' : 'Inactive' }" highlight="{= ${portal>applicationId} &amp;&amp; ${portal>applicationId} === ${portal>/activeApplicationId} ? 'Information' : 'None' }" class="portalMenuItem"><customData><core:CustomData key="menukind" value="{= ${portal>applicationId} ? 'app' : 'group' }" writeToDom="true"/></customData><HBox width="100%" justifyContent="SpaceBetween" alignItems="Center" class="menuItemLayout"><HBox alignItems="Center" class="menuItemPrimary"><HBox alignItems="Center" justifyContent="Center" class="menuItemIconShell"><core:Icon src="{portal>icon}" class="menuItemIcon"/></HBox><VBox class="menuItemText"><Title text="{portal>title}" level="H5"/><Text text="{portal>description}" visible="{= !!${portal>applicationId} }" maxLines="1"/></VBox></HBox><Button icon="{= ${portal>favorite} ? 'sap-icon://favorite' : 'sap-icon://unfavorite' }" type="Transparent" tooltip="즐겨찾기" visible="{= !!${portal>applicationId} }" press=".onToggleFavorite" class="menuFavoriteButton"/></HBox></CustomTreeItem></items></Tree>
            <List id="menuList" visible="{= ${portal>/currentCollection} !== 'menu' }" items="{portal>/visibleMenus}" mode="None" itemPress=".onMenuPress" showNoData="true" noDataText="표시할 업무가 없습니다." class="portalMenuList"><items><CustomListItem type="Active" highlight="{= ${portal>applicationId} === ${portal>/activeApplicationId} ? 'Information' : 'None' }" class="portalMenuItem"><HBox width="100%" justifyContent="SpaceBetween" alignItems="Center" class="menuItemLayout"><HBox alignItems="Center" class="menuItemPrimary"><HBox alignItems="Center" justifyContent="Center" class="menuItemIconShell"><core:Icon src="{portal>icon}" class="menuItemIcon"/></HBox><VBox class="menuItemText"><Title text="{portal>title}" level="H5"/><Text text="{portal>description}" maxLines="1"/></VBox></HBox><Button icon="{= ${portal>favorite} ? 'sap-icon://favorite' : 'sap-icon://unfavorite' }" type="Transparent" tooltip="즐겨찾기" press=".onToggleFavorite" class="menuFavoriteButton"/></HBox></CustomListItem></items></List>
          </VBox>
        </VBox>
        <VBox fitContainer="true" class="workspace">
          <Toolbar class="workspaceHeader"><Title text="Workspace"/><Text text="업무 애플리케이션을 하나의 Portal에서 실행합니다." class="workspaceHeaderSubtitle"/><ToolbarSpacer/><Button text="활동 로그" icon="sap-icon://activity-items" type="Transparent" press=".onOpenActivityLog"/><Button text="현재 앱에 메시지 보내기" icon="sap-icon://discussion-2" type="Transparent" visible="{= ${portal>/openedApplications}.length > 0 }" press=".onSendTestMessage"/><Button text="현재 탭 닫기" icon="sap-icon://decline" type="Transparent" visible="{= ${portal>/openedApplications}.length > 0 }" press=".onCloseActive"/><Button text="전체 닫기" icon="sap-icon://decline" type="Transparent" visible="{= ${portal>/openedApplications}.length > 1 }" press=".onCloseAll"/></Toolbar>
          <Toolbar class="workspaceAdapterPanel"><core:Icon src="sap-icon://process" size="1rem"/><Title text="{portal>/workspaceAdapterInfo/label}" level="H5"/><ToolbarSeparator/><Text text="{portal>/workspaceAdapterInfo/description}" wrapping="false" class="workspaceAdapterDescription"/><ToolbarSpacer/><ObjectStatus text="{portal>/workspaceAdapterInfo/visualCue}" state="Information"/></Toolbar>
          <VBox visible="{= !${portal>/adminOpen} &amp;&amp; ${portal>/openedApplications}.length === 0 }" class="workspaceWelcome" alignItems="Center" justifyContent="Center"><core:Icon src="sap-icon://home-share" size="3rem"/><Title text="업무를 시작하세요" level="H2"/><Text text="좌측 메뉴에서 애플리케이션을 선택하면 이 Workspace에서 실행됩니다." textAlign="Center"/><HBox class="workspaceCapabilities"><ObjectStatus text="역할 기반 메뉴" icon="sap-icon://employee" state="Information"/><ObjectStatus text="SAP · Non-SAP 통합" icon="sap-icon://connected" state="Information"/><ObjectStatus text="교체 가능한 MDI Adapter" icon="sap-icon://process" state="Information"/></HBox></VBox>
          <VBox id="workspaceContent" visible="{= !${portal>/adminOpen} &amp;&amp; ${portal>/openedApplications}.length > 0 }" fitContainer="true" class="workspaceContent"/>
          <VBox visible="{= !${portal>/adminOpen} &amp;&amp; ${portal>/openedApplications}.length === 0 }" fitContainer="true" class="workspaceDashboard">
            <HBox justifyContent="SpaceBetween" alignItems="Center" class="homeHero">
              <VBox><Text text="MY ENTERPRISE WORKSPACE" class="homeEyebrow"/><Title text="{= '안녕하세요, 블루어드 ' + ${portal>/userName} + '님' }" level="H2"/></VBox>
              <VBox alignItems="End" class="homeHeroMeta"><ObjectStatus text="{portal>/currentRole}" icon="sap-icon://employee" state="Information"/><Text text="{portal>/currentDate}"/></VBox>
            </HBox>
            <HBox fitContainer="true" justifyContent="SpaceBetween" alignItems="Stretch" class="homeDashboardMain">
              <VBox width="65%" fitContainer="true" class="homePanel homeNoticePanel">
                <HBox alignItems="Center" class="homePanelHeading"><VBox><Title text="공지사항" level="H3"/><Text text="Portal 운영과 업무 정책의 주요 안내를 확인하세요."/></VBox><ToolbarSpacer/><ObjectStatus text="새 공지 3건" icon="sap-icon://announcement" state="Information"/></HBox>
                <List showSeparators="None" class="homeNoticeList">
                  <CustomListItem class="homeNoticeItem homeNoticeImportant"><HBox width="100%" alignItems="Center"><HBox alignItems="Center" justifyContent="Center" class="homeNoticeBadge"><Text text="중요"/></HBox><VBox class="homeNoticeContent"><HBox alignItems="Center"><Title text="Enterprise Portal 정기 점검 안내" level="H4"/><ObjectStatus text="필독" state="Error"/></HBox><Text text="안정적인 서비스 제공을 위해 8월 9일 22:00부터 23:00까지 정기 점검을 진행합니다." maxLines="1"/><HBox class="homeNoticeMeta"><Text text="2026.08.02"/><Text text="Portal 운영팀"/></HBox></VBox></HBox></CustomListItem>
                  <CustomListItem class="homeNoticeItem"><HBox width="100%" alignItems="Center"><HBox alignItems="Center" justifyContent="Center" class="homeNoticeBadge homeNoticeBadgePolicy"><Text text="정책"/></HBox><VBox class="homeNoticeContent"><HBox alignItems="Center"><Title text="협력사 견적 평가 기준 개정" level="H4"/><ObjectStatus text="업무 안내" state="Warning"/></HBox><Text text="가격·납기·거래평가를 반영한 신규 협력사 선정 기준이 8월 구매요청부터 적용됩니다." maxLines="1"/><HBox class="homeNoticeMeta"><Text text="2026.08.01"/><Text text="구매혁신팀"/></HBox></VBox></HBox></CustomListItem>
                  <CustomListItem class="homeNoticeItem"><HBox width="100%" alignItems="Center"><HBox alignItems="Center" justifyContent="Center" class="homeNoticeBadge homeNoticeBadgeInfo"><Text text="안내"/></HBox><VBox class="homeNoticeContent"><HBox alignItems="Center"><Title text="통합 Workspace 시범 운영 안내" level="H4"/><ObjectStatus text="시범 운영" state="Information"/></HBox><Text text="SAPUI5, React, Vue 업무 화면을 하나의 Workspace에서 실행하는 통합 Portal을 시범 운영합니다." maxLines="1"/><HBox class="homeNoticeMeta"><Text text="2026.07.30"/><Text text="DT 추진팀"/></HBox></VBox></HBox></CustomListItem>
                </List>
                <HBox alignItems="Center" class="homeNoticeGuide"><core:Icon src="sap-icon://hint"/><Text text="중요 공지는 업무 시작 전에 확인해 주세요."/><ToolbarSpacer/><Text text="최근 30일 공지"/></HBox>
              </VBox>
              <VBox width="33%" fitContainer="true" class="homePanel homeRecentPanel">
                <HBox alignItems="Center" class="homePanelHeading"><VBox><Title text="최근 업무" level="H3"/><Text text="중단한 업무를 바로 이어서 실행하세요."/></VBox><ToolbarSpacer/><core:Icon src="sap-icon://history" class="homePanelHeadingIcon"/></HBox>
                <List items="{portal>/dashboardRecent}" mode="None" showSeparators="None" showNoData="false" class="homeRecentList"><items><CustomListItem type="Active" press=".onDashboardOpen" class="homeRecentItem"><HBox width="100%" alignItems="Center"><HBox alignItems="Center" justifyContent="Center" class="homeRecentIcon"><core:Icon src="{portal>icon}"/></HBox><VBox class="homeRecentText"><Title text="{portal>title}" level="H5"/><Text text="{portal>description}" maxLines="1"/></VBox><core:Icon src="sap-icon://navigation-right-arrow" class="homeRecentArrow"/></HBox></CustomListItem></items></List>
                <VBox visible="{= ${portal>/dashboardRecent}.length === 0 }" alignItems="Center" justifyContent="Center" class="homeEmptyRecent"><core:Icon src="sap-icon://history"/><Text text="아직 실행한 업무가 없습니다."/></VBox>
                <HBox alignItems="Center" class="homeSystemHint"><core:Icon src="sap-icon://sys-enter-2"/><Text text="SAP · Non-SAP 통합 서비스 정상"/></HBox>
              </VBox>
            </HBox>
          </VBox>
          <ScrollContainer visible="{portal>/adminOpen}" height="100%" vertical="false" horizontal="false" class="adminScroll">
            <VBox id="adminPanel" height="100%" class="adminPanel">
              <Toolbar class="adminHeader">
                <core:Icon src="sap-icon://settings" class="adminHeaderIcon"/>
                <VBox><Text text="PORTAL CONTROL CENTER" class="adminEyebrow"/><Title text="Portal 관리자 설정" level="H2"/><Text text="메뉴, 실행 애플리케이션과 역할 권한을 한 곳에서 관리합니다."/></VBox>
                <ToolbarSpacer/>
                <ObjectStatus text="관리자 권한" icon="sap-icon://key-user-settings" state="Success" class="adminHeaderStatus"/>
                <Button text="닫기" icon="sap-icon://decline" type="Transparent" press=".onCloseAdmin"/>
                <Button text="변경사항 저장" icon="sap-icon://save" type="Emphasized" press=".onSaveAdmin"/>
              </Toolbar>
              <IconTabBar expandable="false" applyContentPadding="false" stretchContentHeight="true" headerMode="Inline" class="adminTabs"><items>
                <IconTabFilter text="메뉴 관리" icon="sap-icon://menu2" count="{= ${admin>/menus}.length }">
                  <HBox class="adminEditor" fitContainer="true">
                    <VBox width="17rem" class="adminMaster">
                      <Toolbar class="adminMasterHeader"><VBox><Title text="메뉴 구성" level="H4"/><Text text="표시 순서와 연결 대상을 관리합니다."/></VBox><ToolbarSpacer/><Button text="메뉴 추가" icon="sap-icon://add" type="Transparent" press=".onAddMenu"/></Toolbar>
                      <List id="adminMenuList" items="{admin>/menus}" mode="SingleSelectMaster" growing="true" growingThreshold="6" growingTriggerText="메뉴 더 보기" selectionChange=".onAdminMenuSelect" class="adminEntityList"><items><StandardListItem title="{admin>title}" description="{admin>id}" icon="{admin>icon}" info="{= ${admin>active} ? '활성' : '비활성' }" infoState="{= ${admin>active} ? 'Success' : 'None' }"/></items></List>
                    </VBox>
                    <VBox class="adminDetail" fitContainer="true">
                      <HBox justifyContent="SpaceBetween" alignItems="Center" class="adminDetailHeading"><VBox><Title text="메뉴 상세" level="H3"/><Text text="선택한 메뉴의 노출 정보, 실행 대상과 권한을 설정합니다."/></VBox><ObjectStatus text="{= ${admin>/selectedMenu/active} ? '활성 메뉴' : '비활성 메뉴' }" icon="sap-icon://status-positive" state="{= ${admin>/selectedMenu/active} ? 'Success' : 'None' }"/></HBox>
                      <VBox class="adminFormBody">
                      <VBox class="adminFormSection"><HBox alignItems="Center" class="adminSectionTitle"><core:Icon src="sap-icon://edit"/><Title text="기본 정보" level="H5"/></HBox><HBox class="formRow"><VBox><Label text="메뉴 ID" required="true"/><Input value="{admin>/selectedMenu/id}"/></VBox><VBox><Label text="메뉴명" required="true"/><Input value="{admin>/selectedMenu/title}"/></VBox><VBox><Label text="표시 순서"/><Input value="{admin>/selectedMenu/order}" type="Number"/></VBox></HBox></VBox>
                      <VBox class="adminFormSection"><HBox alignItems="Center" class="adminSectionTitle"><core:Icon src="sap-icon://connected"/><Title text="연결 및 권한" level="H5"/></HBox><HBox class="formRow"><VBox><Label text="상위 업무 그룹"/><Input value="{admin>/selectedMenu/parentId}" placeholder="예: finance, procurement"/></VBox><VBox><Label text="실행 애플리케이션" required="true"/><Select width="100%" selectedKey="{admin>/selectedMenu/applicationId}" items="{admin>/applications}"><items><core:Item key="{admin>id}" text="{admin>title}"/></items></Select></VBox><VBox><Label text="접근 역할"/><Input value="{admin>/selectedMenu/rolesText}" placeholder="PORTAL_USER, FI_USER"/></VBox></HBox></VBox>
                      <VBox class="adminFormSection"><HBox alignItems="Center" class="adminSectionTitle"><core:Icon src="sap-icon://palette"/><Title text="표시 설정" level="H5"/></HBox><HBox class="formRow"><VBox><Label text="설명"/><Input value="{admin>/selectedMenu/description}"/></VBox><VBox><Label text="SAP 아이콘"/><Input value="{admin>/selectedMenu/icon}" placeholder="sap-icon://menu2"/></VBox><VBox><Label text="사용 상태"/><HBox alignItems="Center" class="adminSwitchField"><Switch state="{admin>/selectedMenu/active}"/><Text text="{= ${admin>/selectedMenu/active} ? '사용' : '사용 안 함' }"/></HBox></VBox></HBox></VBox>
                      </VBox>
                      <Toolbar class="adminDetailFooter"><ObjectStatus text="ID와 메뉴명은 필수 입력 항목입니다." icon="sap-icon://hint" state="Information"/><ToolbarSpacer/><Button text="선택 메뉴 삭제" icon="sap-icon://delete" type="Negative" press=".onDeleteSelectedMenu"/></Toolbar>
                    </VBox>
                  </HBox>
                </IconTabFilter>
                <IconTabFilter text="애플리케이션 관리" icon="sap-icon://product" count="{= ${admin>/applications}.length }">
                  <HBox class="adminEditor" fitContainer="true">
                    <VBox width="17rem" class="adminMaster">
                      <Toolbar class="adminMasterHeader"><VBox><Title text="애플리케이션" level="H4"/><Text text="Portal 실행 카탈로그입니다."/></VBox><ToolbarSpacer/><Button text="앱 추가" icon="sap-icon://add" type="Transparent" press=".onAddApplication"/></Toolbar>
                      <List id="adminApplicationList" items="{admin>/applications}" mode="SingleSelectMaster" growing="true" growingThreshold="6" growingTriggerText="애플리케이션 더 보기" selectionChange=".onAdminApplicationSelect" class="adminEntityList"><items><StandardListItem title="{admin>title}" description="{admin>applicationType}" icon="{admin>icon}" info="{= ${admin>active} ? '활성' : '비활성' }" infoState="{= ${admin>active} ? 'Success' : 'None' }"/></items></List>
                    </VBox>
                    <VBox class="adminDetail" fitContainer="true">
                      <HBox justifyContent="SpaceBetween" alignItems="Center" class="adminDetailHeading"><VBox><Title text="애플리케이션 상세" level="H3"/><Text text="실행 방식, 대상 주소와 접근 역할을 설정합니다."/></VBox><ObjectStatus text="{= ${admin>/selectedApplication/active} ? '운영 중' : '비활성' }" icon="sap-icon://connected" state="{= ${admin>/selectedApplication/active} ? 'Success' : 'None' }"/></HBox>
                      <VBox class="adminFormBody">
                      <VBox class="adminFormSection"><HBox alignItems="Center" class="adminSectionTitle"><core:Icon src="sap-icon://edit"/><Title text="기본 정보" level="H5"/></HBox><HBox class="formRow"><VBox><Label text="애플리케이션 ID" required="true"/><Input value="{admin>/selectedApplication/id}"/></VBox><VBox><Label text="제목" required="true"/><Input value="{admin>/selectedApplication/title}"/></VBox><VBox><Label text="실행 유형"/><Select width="100%" selectedKey="{admin>/selectedApplication/applicationType}"><items><core:Item key="UI5_COMPONENT" text="UI5 Component"/><core:Item key="IFRAME" text="iframe"/><core:Item key="EXTERNAL_WINDOW" text="외부 창"/><core:Item key="CUSTOM_HANDLER" text="Custom Handler"/></items></Select></VBox></HBox></VBox>
                      <VBox class="adminFormSection"><HBox alignItems="Center" class="adminSectionTitle"><core:Icon src="sap-icon://process"/><Title text="실행 및 권한" level="H5"/></HBox><HBox class="formRow"><VBox><Label text="실행 대상" required="true"/><Input value="{admin>/selectedApplication/target}" placeholder="URL 또는 Component namespace"/></VBox><VBox><Label text="Navigation Mode"/><Select width="100%" selectedKey="{admin>/selectedApplication/navigationMode}"><items><core:Item key="TAB" text="Workspace Tab"/><core:Item key="NEW_WINDOW" text="New Window"/></items></Select></VBox><VBox><Label text="접근 역할"/><Input value="{admin>/selectedApplication/rolesText}" placeholder="PORTAL_USER, FI_USER"/></VBox></HBox></VBox>
                      <VBox class="adminFormSection"><HBox alignItems="Center" class="adminSectionTitle"><core:Icon src="sap-icon://palette"/><Title text="표시 설정" level="H5"/></HBox><HBox class="formRow"><VBox><Label text="설명"/><Input value="{admin>/selectedApplication/description}"/></VBox><VBox><Label text="SAP 아이콘"/><Input value="{admin>/selectedApplication/icon}" placeholder="sap-icon://application"/></VBox><VBox><Label text="사용 상태"/><HBox alignItems="Center" class="adminSwitchField"><Switch state="{admin>/selectedApplication/active}"/><Text text="{= ${admin>/selectedApplication/active} ? '사용' : '사용 안 함' }"/></HBox></VBox></HBox></VBox>
                      </VBox>
                      <Toolbar class="adminDetailFooter"><ObjectStatus text="ID, 제목과 실행 대상은 필수 입력 항목입니다." icon="sap-icon://hint" state="Information"/><ToolbarSpacer/><Button text="선택 애플리케이션 삭제" icon="sap-icon://delete" type="Negative" press=".onDeleteSelectedApplication"/></Toolbar>
                    </VBox>
                  </HBox>
                </IconTabFilter>
              </items></IconTabBar>
            </VBox>
          </ScrollContainer>
        </VBox>
      </HBox>
    </VBox>
    <Button visible="{= !${assistant>/open} }" icon="sap-icon://da" type="Transparent" tooltip="AI 업무 도우미 열기" press=".onToggleAssistant" class="aiFloatingLauncher"/>
    <VBox visible="{assistant>/open}" class="aiAssistantPanel">
      <HBox alignItems="Center" class="aiAssistantHeader">
        <HBox alignItems="Center" justifyContent="Center" class="aiAssistantLogo"><core:Icon src="sap-icon://da"/></HBox>
        <VBox class="aiAssistantHeading"><Text text="PORTAL AI COPILOT" class="aiAssistantEyebrow"/><Title text="업무 AI 도우미" level="H2"/></VBox>
        <ObjectStatus text="AI READY" state="Success" class="aiAssistantReady"/>
        <Button icon="sap-icon://decline" type="Transparent" tooltip="AI 도우미 닫기" press=".onCloseAssistant" class="aiAssistantClose"/>
      </HBox>
      <VBox class="aiContextCard">
        <HBox alignItems="Center">
          <HBox alignItems="Center" justifyContent="Center" class="aiContextIcon"><core:Icon src="sap-icon://business-objects-experience"/></HBox>
          <VBox class="aiContextText"><Text text="현재 업무 문맥"/><Title text="{assistant>/contextTitle}" level="H4"/></VBox>
        </HBox>
        <Text text="{assistant>/contextDetail}" wrapping="false" class="aiContextDetail"/>
      </VBox>
      <VBox class="aiSuggestionArea">
        <Text text="추천 질문" class="aiSectionLabel"/>
        <HBox wrap="Wrap" items="{assistant>/suggestions}" class="aiSuggestionWrap"><items><Button text="{assistant>title}" icon="{assistant>icon}" type="Transparent" press=".onAssistantSuggestion" class="aiSuggestionButton"/></items></HBox>
      </VBox>
      <ScrollContainer id="assistantConversation" height="100%" vertical="true" horizontal="false" class="aiConversation">
        <List items="{assistant>/messages}" mode="None" showSeparators="None" class="aiMessageList"><items>
          <CustomListItem class="aiMessageItem">
            <customData><core:CustomData key="role" value="{assistant>role}" writeToDom="true"/></customData>
            <VBox class="aiMessageBubble">
              <HBox width="100%" justifyContent="SpaceBetween" alignItems="Center" class="aiMessageMeta"><Text text="{assistant>roleLabel}"/><Text text="{assistant>time}" class="aiMessageTime"/></HBox>
              <Text text="{assistant>text}" wrapping="true" class="aiMessageText"/>
              <VBox visible="{= !!${assistant>card} }" class="aiAnswerCard">
                <Text text="{assistant>card/eyebrow}" class="aiAnswerEyebrow"/>
                <HBox width="100%" justifyContent="SpaceBetween" alignItems="Start" class="aiAnswerHeading">
                  <VBox class="aiAnswerTitle"><Title text="{assistant>card/title}" level="H5"/><Text text="{assistant>card/subtitle}" wrapping="true" visible="{= !!${assistant>card/subtitle} }"/></VBox>
                  <ObjectStatus text="{assistant>card/status}" state="{assistant>card/statusState}" visible="{= !!${assistant>card/status} }" class="aiAnswerStatus"/>
                </HBox>
                <HBox wrap="Wrap" items="{assistant>card/facts}" class="aiAnswerFacts"><items>
                  <VBox class="aiAnswerFact"><customData><core:CustomData key="state" value="{assistant>state}" writeToDom="true"/></customData><Text text="{assistant>label}"/><Text text="{assistant>value}"/></VBox>
                </items></HBox>
              </VBox>
              <Button text="{assistant>actionLabel}" icon="sap-icon://navigation-right-arrow" type="Transparent" visible="{= !!${assistant>actionMenuId} }" press=".onAssistantAction" class="aiMessageAction"/>
            </VBox>
          </CustomListItem>
        </items></List>
        <HBox visible="{assistant>/busy}" alignItems="Center" class="aiTypingBubble"><HBox alignItems="Center" justifyContent="Center" class="aiTypingIcon"><core:Icon src="sap-icon://da"/></HBox><VBox><Text text="AI 업무 도우미" class="aiTypingLabel"/><Text text="답변을 구성하고 있습니다…"/></VBox></HBox>
      </ScrollContainer>
      <VBox class="aiComposer">
        <HBox width="100%" alignItems="Center" class="aiComposerRow"><Input width="100%" value="{assistant>/draft}" placeholder="업무에 대해 무엇이든 물어보세요" submit=".onAssistantSend" enabled="{= !${assistant>/busy} }" class="aiComposerInput"/><Button icon="sap-icon://paper-plane" type="Emphasized" tooltip="질문 보내기" press=".onAssistantSend" enabled="{= !${assistant>/busy} }" class="aiSendButton"/></HBox>
        <HBox alignItems="Center" class="aiPrivacyHint"><core:Icon src="sap-icon://locked"/><Text text="PoC 시뮬레이션 · 업무 데이터는 외부로 전송되지 않습니다."/></HBox>
      </VBox>
    </VBox>
  </Page>
</mvc:View>
